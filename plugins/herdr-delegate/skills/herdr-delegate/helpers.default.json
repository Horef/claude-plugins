{
  "tier_text": {
    "light": "mechanical work with a clear rule",
    "standard": "code to a spec, summaries, web research",
    "deep": "open judgment, unclear failures, long research",
    "argon": "a second opinion from another model family"
  },
  "providers": {
    "kiro": {
      "cli": "kiro-cli",
      "label": "Kiro",
      "command": "kiro-cli chat --v3 --trust-workspace --model {model} --effort {effort}",
      "efforts": ["low", "medium", "high", "xhigh", "max"],
      "note": "Approve-for-me permissions.",
      "models_source": "kiro-list",
      "tiers": {
        "light": {"model": "claude-haiku-5.5", "effort": "low"},
        "standard": {"model": "claude-sonnet-5.5", "effort": "high"},
        "deep": {"model": "claude-opus-5.5", "effort": "high"}
      }
    },
    "copilot": {
      "cli": "copilot",
      "label": "Copilot",
      "command": "copilot --no-ask-user --model {model} --reasoning-effort {effort}",
      "efforts": ["none", "minimal", "low", "medium", "high", "xhigh", "max"],
      "note": "Assisted permissions. No status reports: hc wait cannot see it.",
      "models_source": "copilot-acp",
      "tiers": {
        "light": {"model": "gpt-6-luna", "effort": "high"},
        "standard": {"model": "claude-sonnet-5.5", "effort": "high"},
        "deep": {"model": "claude-opus-5.5", "effort": "high"},
        "argon": {"model": "gemini-4-argon", "effort": "high"},
        "fusion-high": {
          "command": "COPILOT_CLI_ENABLED_FEATURE_FLAGS=DYNAMIC_AUTO_TIERS,HYDRAFUSION,HYDRAFUSION_ROLLOUT,HYDRAFUSION_PLAN_V2 copilot --no-ask-user --model auto --auto-tier hydrafusion",
          "description": "Copilot helper on Copilot Fusion High (a router across Claude and GPT-6 models; effort chosen per step, not settable). Opt-in, not in any default order. Assisted permissions. No status reports."
        },
        "fusion-max": {
          "command": "COPILOT_CLI_ENABLED_FEATURE_FLAGS=DYNAMIC_AUTO_TIERS,HYDRAFUSION,HYDRAFUSION_ROLLOUT,HYDRAFUSION_PLAN_V2 copilot --no-ask-user --model auto --auto-tier hydrafusion-max",
          "description": "Copilot helper on Copilot Fusion Max (a router across Claude and GPT-6 models; effort chosen per step, not settable). Opt-in, not in any default order. Assisted permissions. No status reports."
        }
      }
    },
    "agy": {
      "cli": "agy",
      "label": "Antigravity",
      "command": "agy --model {model_id} --mode auto --settings {settings}",
      "settings": {"permissions": {"allow": ["command(cat)", "command(head)", "command(tail)", "command(wc)", "command(ls)", "command(pwd)", "command(grep)", "command(rg)", "command(sed -n)", "command(sort)", "command(uniq)", "command(cut)", "command(diff)", "command(stat)", "command(du)", "command(file)", "command(jq)", "command(echo)", "command(date)", "command(which)", "command(pdftotext)", "command(git log)", "command(git diff)", "command(git show)", "command(git status)", "command(git grep)", "command(git blame)", "command(git ls-files)", "command(git rev-parse)", "command(hc send)"]}},
      "settings_note": "Auto mode is still a rollout (agy says \"--mode auto is not available for this account\" and falls back to asking for every command), so the template passes a read-only allowlist with --settings; everything else still asks the lead.",
      "model_id": "{model}-{effort}",
      "efforts": ["low", "medium", "high"],
      "note": "Personal subscription: small quota, use after Kiro and Copilot.",
      "models_source": "agy-list",
      "tiers": {
        "light": {"model": "gemini-3.8-flash", "effort": "high"},
        "standard": {"model": "claude-sonnet-5-5", "effort": "high"},
        "deep": {"model": "claude-opus-5-5", "effort": "high"},
        "argon": {"model": "gemini-4-argon", "effort": "high"}
      }
    }
  },
  "custom": []
}
